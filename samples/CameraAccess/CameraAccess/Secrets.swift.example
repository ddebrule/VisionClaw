// Secrets.swift is gitignored and will not be committed.

import Foundation

enum Secrets {
  // REQUIRED: Get your key at https://aistudio.google.com/apikey
  static let geminiAPIKey = "YOUR_GEMINI_API_KEY"

  // REQUIRED for Scout_IQ: Your Spectre deployment URL (no trailing slash)
  static let spectreTTSURL = "YOUR_SPECTRE_TTS_URL"     // e.g. https://apex-v4-abc.vercel.app/api/tts
  static let spectreScoutURL = "YOUR_SPECTRE_SCOUT_URL" // e.g. https://apex-v4-abc.vercel.app/api/scout
  static let spectreUserToken = "YOUR_SPECTRE_USER_TOKEN" // from Settings -> Scout_IQ section

  // OPTIONAL: OpenClaw gateway config (for agentic tool-calling)
  static let openClawHost = "http://YOUR_MAC_HOSTNAME.local"
  static let openClawPort = 18789
  static let openClawHookToken = "YOUR_OPENCLAW_HOOK_TOKEN"
  static let openClawGatewayToken = "YOUR_OPENCLAW_GATEWAY_TOKEN"

  // OPTIONAL: WebRTC signaling server URL
  static let webrtcSignalingURL = "ws://YOUR_MAC_IP:8080"
}
